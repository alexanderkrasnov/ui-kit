# Pin the @alexanderkrasnov scope to GitHub Packages.
# This is the primary mitigation for dependency-confusion attacks: even if
# someone publishes a malicious @alexanderkrasnov/* package on public npmjs.org,
# the resolver MUST go to GitHub Packages for this scope.
@alexanderkrasnov:registry=https://npm.pkg.github.com/

# Default registry — explicit, so resolution is never ambiguous.
registry=https://registry.npmjs.org/

# Refuse to install if a dep was added via insecure transport.
strict-ssl=true

# Require auth tokens to be sent only to https registries.
always-auth=false

# Make `npm install` behave like `npm ci` w.r.t. lockfile fidelity.
package-lock=true
